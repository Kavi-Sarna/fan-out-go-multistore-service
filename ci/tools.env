# Tool versions, in one place.
#
# Written as NAME=value so that both `make` (via include) and bash (via
# source) can read it. Two copies of a version pin is the same drift this
# project exists to avoid, one level down.
GOLANGCI_VER=v2.11.2
GOIMPORTS_VER=v0.39.0
GOVULNCHECK_VER=v1.9.0
TRIVY_VER=v0.74.0
